# task3. - Останні N подій (Кільцевий буфер)


def main():
    N = 5
    buffer = [None] * N
    write_index = 0
    total_events = 0

    events = [f"Подія_{i}" for i in range(1, 9)]

    for event in events:
        buffer[write_index] = event
        write_index = (write_index + 1) % N
        total_events += 1

    print("--- Останні 5 подій ---")
    count = min(total_events, N)
    start_index = (
        (write_index - count + N) % N if total_events >= N else 0
    )

    for i in range(count):
        idx = (start_index + i) % N
        print(buffer[idx])


if __name__ == "__main__":
    main()
