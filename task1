# task1 - Журнал у зворотному порядку


def main():
    logs = [
        "Запуск системи",
        "Авторизація користувача",
        "Натискання кнопки",
        "Завантаження даних",
        "Помилка з'єднання",
    ]

    journal = []
    for log in logs:
        journal.append(log)

    print("--- Журнал у зворотному порядку ---")
    for i in range(len(journal) - 1, -1, -1):
        print(journal[i])


if __name__ == "__main__":
    main()
