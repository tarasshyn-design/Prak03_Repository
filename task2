# task2. - Підсумки за місяцями


def main():
    transactions = [(1, 150), (3, 300), (1, 50), (12, 1000), (3, 100)]
    monthly_totals = [0] * 12

    for month, amount in transactions:
        monthly_totals[month - 1] += amount

    print("--- Підсумки за 12 місяців ---")
    for month_idx in range(12):
        print(f"Місяць {month_idx + 1}: {monthly_totals[month_idx]}")


if __name__ == "__main__":
    main()
